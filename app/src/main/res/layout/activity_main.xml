<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_icon_btn"
                android:contentDescription="Menu"
                android:src="@drawable/ic_menu"
                android:padding="14dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:text="@string/brand_title"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCrown"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_icon_btn"
                android:contentDescription="Pro"
                android:src="@drawable/ic_crown"
                android:padding="14dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSelectServer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/pill_dark"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingTop="14dp"
            android:paddingEnd="22dp"
            android:paddingBottom="14dp">
            <TextView
                android:id="@+id/tvSelectedServer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/select_server"
                android:textColor="@color/muted"
                android:textSize="18sp" />
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/ic_chev_right" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/stateIdle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <Button
                    android:id="@+id/btnBegin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_outline"
                    android:letterSpacing="0.05"
                    android:paddingStart="52dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="52dp"
                    android:paddingBottom="22dp"
                    android:text="@string/begin_speed_test"
                    android:textColor="@color/text"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stateRunning"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">
                <com.jepongdevxyz.devxyzdns.SpeedCircleView
                    android:id="@+id/speedCircle"
                    android:layout_width="260dp"
                    android:layout_height="260dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp"
                    android:letterSpacing="0.04"
                    android:text="@string/finding_fastest"
                    android:textColor="@color/text"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <include layout="@layout/bottom_nav" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/bg">
        <include layout="@layout/drawer_content" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
